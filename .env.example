# Kalitsiz lokal demo: .env ga nusxalang. Maxfiy qiymatlarni Git ga yuklamang.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/catalog.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
INIT_DATA_TTL_SECONDS=3600
OFFER_MAX_AGE_HOURS=48
RATE_LIMIT_PER_MINUTE=120

# BotFather tokeni faqat Telegram botni ulashda kerak.
BOT_TOKEN=
BOT_INTERNAL_TOKEN=
MINI_APP_URL=
API_BASE_URL=http://127.0.0.1:8000

# Admin API uchun kamida 32 ta tasodifiy belgi; start.ps1 avtomatik yaratadi.
# Telegram /admin and Mini App admin access (comma-separated numeric IDs)
ADMIN_TELEGRAM_IDS=
ADMIN_TOKEN=
# Docker PostgreSQL uchun alfanumerik tasodifiy parol (URL ichida ishlatiladi).
POSTGRES_PASSWORD=
ALLOWED_STORE_DOMAINS=uzum.uz,asaxiy.uz,www.olx.uz,olcha.uz,texnomart.uz,mediapark.uz
LOG_LEVEL=INFO

# Kunlik yangi mahsulotlar: server tayyor va bot kanalda admin bo‘lgach yoqing.
COLLECTION_ENABLED=false
DAILY_POST_ENABLED=false
DAILY_CHANNEL_ID=@arzon_narx_topamiz
DAILY_POST_TIME=09:00
DAILY_MAX_ITEMS=10
COLLECTION_POLL_SECONDS=60

# Generativ AI — Google Gemini Flash-Lite bepul tarifi (foydalanish limiti bor).
# Kalitni faqat Render backend Environment da maxfiy saqlang.
# Frontend VITE_* variables yoki GitHub ga hech qanday API kaliti yozmang.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ixtiyoriy muqobil OpenAI integratsiyasi (default emas):
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
